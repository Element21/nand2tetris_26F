// File name: projects/5/CPU.hdl
/**
 * The Hack Central Processing unit (CPU).
 * Parses the binary code in the instruction input and executes it according to the
 * Hack machine language specification. In the case of a C-instruction, computes the
 * function specified by the instruction. If the instruction specifies to read a memory
 * value, the inM input is expected to contain this value. If the instruction specifies
 * to write a value to the memory, sets the outM output to this value, sets the addressM
 * output to the target address, and asserts the writeM output (when writeM = 0, any
 * value may appear in outM).
 * If the reset input is 0, computes the address of the next instruction and sets the
 * pc output to that value. If the reset input is 1, sets pc to 0.
 * Note: The outM and writeM outputs are combinational: they are affected by the
 * instruction's execution during the current cycle. The addressM and pc outputs are
 * clocked: although they are affected by the instruction's execution, they commit to
 * their new values only in the next cycle.
 */
CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // Is A instruction?
    Not(in=instruction[15], out=isAInst);
    Not(in=isAInst, out=isCInst);

    // Memory or ALU output into A?
    // A instruction == address[15] = 0
    // If A instruction, load instruction bits directly as value, discarding the MSB (only specifies if a instruction)
    Mux16(a=ALUOutput, b=instruction, sel=isAInst, out=ARegisterContents);
   
    // (If c instruction and destination is A) or (isAInst). Load A
    And(a=isCInst, b=instruction[5], out=CInstNeedsToLoadA);
    Or(a=isAInst, b=CInstNeedsToLoadA, out=loadA);
    ARegister(in=ARegisterContents, load=loadA, out=ARegisterOutput, out[0..14]=addressM); // addressM = ARegisterOutput

    // writeM - C instruction AND destination is M, write to memory
    And(a=instruction[3], b=isCInst, out=writeM);

    // A register or inM into ALU? ('a' bit of c instruction)
    Mux16(a=ARegisterOutput, b=inM, sel=instruction[12], out=inMOrAForALU);

    // D Register Temp storage of ALU output
    // instruction[4] - Middle of the three d bits sepcifies the D register
    // Only load D register on C instructions
    And(a=isCInst, b=instruction[4], out=loadD);
    DRegister(in=ALUOutput, load=loadD, out=DRegisterForALU);

    // Pass C instruction bits directly to ALU
    ALU(x=DRegisterForALU, y=inMOrAForALU, zx=instruction[11], nx=instruction[10], zy=instruction[9], ny=instruction[8], f=instruction[7], no=instruction[6], out=ALUOutput, out=outM, zr=zr, ng=ng);


    // // 0;JMP - PC loads A (unconditional)
    // // D;JGT - PC loads A IF condition met, else Inc pc by one (depends on value in D)
    // J bits: instruction[0..2]
    // LT EQ GT
    // 000 - No jump (just increment PC)
    // 001 - JGT
    // 010 - JEQ
    // 011 - JGE
    // 100 - JLT
    // 101 - JNE
    // 110 - JLE
    // 111 - Unconditional (load A and jump)
    
    // No jump - just inc pc
    Or(a=instruction[0], b=instruction[1], out=lsbJBitsZero);
    Or(a=lsbJBitsZero, b=instruction[2], out=noJumpIncPC);

    // Global conditions for conditional jump
    Not(in=ng, out=dIsPositive);
    Not(in=zr, out=dIsNonZero);
    Not(in=dIsPositive, out=dIsNegative);

    // // JGT - D > 0
    // Positive AND non-zero in D AND LSB jump bit (> condition)
    And(a=dIsPositive, b=dIsNonZero, out=possibleJGT);
    // LSB jump bit (> condition)
    And(a=possibleJGT, b=instruction[0], out=JGT);

    // // JEQ - D = 0 Check
    // zr AND middle jump bit (= condition)
    And(a=zr, b=instruction[1], out=JEQ);

    // // JGE - D >= 0 check
    // (zr OR dIsPositive) AND BOTH JGE bits set
    Or(a=zr, b=dIsPositive, out=possibleJGE);
    And(a=possibleJGE, b=instruction[0], out=possibleJGEandGreaterThan0);
    And(a=possibleJGEandGreaterThan0, b=instruction[1], out=JGE);

    // // JLT - D < 0 check
    // dIsNonZero AND dIsNegative AND MSB jump bit (< condition)
    And(a=dIsNonZero, b=dIsNegative, out=possibleJLT);
    And(a=instruction[2], b=possibleJLT, out=JLT);

    // // JNE - D != 0 check
    // dIsNonZero AND JNE bits set
    And(a=dIsNonZero, b=instruction[0], out=dIsNonZeroAndGt);
    And(a=dIsNonZeroAndGt, b=instruction[2], out=JNE);

    // // JLE - J <= 0 check
    // dIsNonZero AND dIsNegative AND JLE bits
    And(a=dIsNonZero, b=dIsNegative, out=possibleJLE);
    And(a=possibleJLE, b=instruction[1], out=possibleJLEAndEq);
    And(a=possibleJLEAndEq, b=instruction[2], out=JLE);

    // // Unconditional - Load A; JMP 
    And(a=instruction[0], b=instruction[1], out=gtAndEqToBits);
    And(a=gtAndEqToBits, b=instruction[2], out=unconditional);


    // Combine all "load a?" outcomes (conditional jump true)
    Or(a=JGT, b=JEQ, out=JGTOrJEQ);
    Or(a=JGTOrJEQ, b=JGE, out=JGTOrJEQOrJGE);
    Or(a=JGTOrJEQOrJGE, b=JLT, out=JGTOrJEQOrJGEOrJLT);
    Or(a=JGTOrJEQOrJGEOrJLT, b=JNE, out=JGTOrJEQOrJGEOrJLTOrJNE);
    Or(a=JGTOrJEQOrJGEOrJLTOrJNE, b=JLE, out=JGTOrJEQOrJGEOrJLTOrJNEOrJLE);
    Or(a=JGTOrJEQOrJGEOrJLTOrJNEOrJLE, b=unconditional, out=loadPCWithA);

    // Only evalutate jumps if c instrction (data in A may look like a jump)
    And(a=isCInst, b=loadPCWithA, out=doJump);

    // Combine all "increment PC?" outcomes (no jump or conditional jump false)
    Not(in=doJump, out=conditionalJumpFalseIncPC);
    Or(a=noJumpIncPC, b=conditionalJumpFalseIncPC, out=incPC);

    PC(in=ARegisterOutput, load=doJump, inc=incPC, reset=reset, out[0..14]=pc);
}