// File name: projects/1/Or8Way.hdl
/**
 * 8-way Or gate: 
 * out = in[0] Or in[1] Or ... Or in[7]
 */
CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    Or(a=in[0], b=in[1], out=firstPair);
    Or(a=firstPair, b=in[2], out=seccondPair);
    Or(a=seccondPair, b=in[3], out=thirdPair);
    Or(a=thirdPair, b=in[4], out=fourthPair);
    Or(a=fourthPair, b=in[5], out=fifthPair);
    Or(a=fifthPair, b=in[6], out=sixthPair);
    Or(a=sixthPair, b=in[7], out=out);
}